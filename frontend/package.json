{
  "name": "recipe-lab-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api:contracts:check": "node scripts/api-contract-codegen.mjs check",
    "api:contracts:generate": "node scripts/api-contract-codegen.mjs generate",
    "architecture:check": "node scripts/frontend-architecture.mjs",
    "ci:verify": "npm test && npm run architecture:check && npm run reachability:check && npm run build && npm run test:e2e:discover",
    "styles:contracts:check": "node scripts/css-architecture.mjs",
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "lint": "eslint .",
    "reachability:check": "node scripts/source-reachability.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright-mode.mjs",
    "test:e2e:discover": "node scripts/discover-playwright-modes.mjs",
    "test:e2e:smoke": "node scripts/run-playwright-mode.mjs smoke",
    "test:e2e:acceptance": "node scripts/run-playwright-mode.mjs acceptance",
    "test:e2e:performance": "node scripts/run-playwright-mode.mjs performance",
    "test:e2e:release": "node scripts/run-playwright-mode.mjs release",
    "test:e2e:visual": "npm run build && node scripts/run-playwright-mode.mjs visual",
    "test:e2e:baseline": "npm run test:e2e:visual",
    "test:e2e:baseline:update": "npm run test:e2e:visual -- --update-snapshots=all",
    "test:e2e:release-gate": "npm run test:e2e:release"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
