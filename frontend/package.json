{
  "name": "recipe-lab-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api:contracts:check": "node scripts/api-contract-codegen.mjs check",
    "api:contracts:generate": "node scripts/api-contract-codegen.mjs generate",
    "ci:verify": "npm test && npm run reachability:check && npm run build && npx --no-install playwright test --list",
    "styles:contracts:check": "node scripts/css-architecture.mjs",
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "lint": "eslint .",
    "reachability:check": "node scripts/source-reachability.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "npm run build && playwright test --config=playwright.baseline.config.ts",
    "test:e2e:baseline:update": "npm run build && playwright test --config=playwright.baseline.config.ts --update-snapshots=all",
    "test:e2e:release-gate": "playwright test e2e/rcp32-community-release-gate.spec.ts"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
