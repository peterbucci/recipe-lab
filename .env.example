# PostgreSQL (development defaults only; choose a real password outside local use)
POSTGRES_DB=recipe_lab
POSTGRES_USER=recipe_lab
POSTGRES_PASSWORD=recipe_lab
POSTGRES_PORT=5432

# Used when the backend runs directly on the host. Docker Compose constructs its
# own URL with the database service name.
DATABASE_URL=postgresql+psycopg://recipe_lab:recipe_lab@localhost:5432/recipe_lab
# Schema tests create and drop isolated schemas inside this local database.
TEST_DATABASE_URL=postgresql+psycopg://recipe_lab:recipe_lab@localhost:5432/recipe_lab
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Account/session security. Hosted OIDC sign-in is disabled until OIDC_ISSUER and
# OIDC_CLIENT_ID are configured. The redirect URI must exactly match one of the
# provider's registered callbacks.
APP_ENVIRONMENT=local
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_RECENT_TTL_SECONDS=600
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPES=openid email profile
OIDC_ALLOWED_SIGNING_ALGORITHMS=RS256
OIDC_LOGIN_TTL_SECONDS=600
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_CLOCK_SKEW_SECONDS=30

# Legacy browser-visible API base URL. New browser calls use the same-origin
# Next.js /api proxy; this remains for backward-compatible server fallbacks.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side Next.js requests. The Compose default uses http://backend:8000.
RECIPE_API_URL=http://localhost:8000
