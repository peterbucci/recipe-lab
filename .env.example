# PostgreSQL (development defaults only; choose a real password outside local use).
# Update the reviewed image tag and digest together; never replace it with latest.
POSTGRES_IMAGE=postgres:17.11-alpine@sha256:7456ef82e5f5bc43d997f4781bbd7c0d6389bff397564649a356e206ba473aee
POSTGRES_DB=recipe_lab
POSTGRES_USER=recipe_lab
POSTGRES_PASSWORD=recipe_lab
POSTGRES_PORT=5432

# Used when the backend runs directly on the host. Docker Compose constructs its
# own URL with the database service name.
DATABASE_URL=postgresql+psycopg://recipe_lab:recipe_lab@localhost:5432/recipe_lab
DATABASE_OPERATION_TIMEOUT_SECONDS=5
# Schema tests create and drop isolated schemas inside this local database.
TEST_DATABASE_URL=postgresql+psycopg://recipe_lab:recipe_lab@localhost:5432/recipe_lab
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Account/session security. Hosted OIDC sign-in is disabled until OIDC_ISSUER and
# OIDC_CLIENT_ID are configured. The redirect URI must exactly match one of the
# provider's registered callbacks.
APP_ENVIRONMENT=local
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SESSION_TTL_SECONDS=1209600
# Refresh last-seen persistence at most once per active session in this interval.
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_RECENT_TTL_SECONDS=600
MAX_REQUEST_BODY_BYTES=2097152
# Replace both secret values with separate long random secrets in production.
# The abuse secret pseudonymizes account, OIDC identity, and network subjects;
# the internal signal secret authenticates the frontend-to-backend network hint.
ABUSE_RATE_LIMIT_SECRET=recipe-lab-local-development-rate-limit-secret
INTERNAL_NETWORK_SIGNAL_SECRET=recipe-lab-local-internal-network-signal-secret
INTERNAL_NETWORK_SIGNAL_TTL_SECONDS=30
ABUSE_RATE_LIMIT_WINDOW_SECONDS=60
ABUSE_RATE_LIMIT_AUTH_NETWORK=120
ABUSE_RATE_LIMIT_AUTH_IDENTITY=30
ABUSE_RATE_LIMIT_DRAFT_ACCOUNT=120
ABUSE_RATE_LIMIT_DRAFT_NETWORK=600
ABUSE_RATE_LIMIT_FORK_ACCOUNT=30
ABUSE_RATE_LIMIT_FORK_NETWORK=120
ABUSE_RATE_LIMIT_PUBLICATION_ACCOUNT=30
ABUSE_RATE_LIMIT_PUBLICATION_NETWORK=120
ABUSE_RATE_LIMIT_REPORT_ACCOUNT=30
ABUSE_RATE_LIMIT_REPORT_NETWORK=120
ABUSE_RATE_LIMIT_INTERACTION_ACCOUNT=600
ABUSE_RATE_LIMIT_INTERACTION_NETWORK=2400
# Research-preview ranking fails closed rather than silently truncating either input.
RECOMMENDATION_MAX_CANDIDATES=2000
RECOMMENDATION_MAX_PROFILE_RECORDS=5000
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPES=openid email profile
OIDC_ALLOWED_SIGNING_ALGORITHMS=RS256
OIDC_LOGIN_TTL_SECONDS=600
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_CLOCK_SKEW_SECONDS=30

# Legacy browser-visible API base URL. New browser calls use the same-origin
# Next.js /api proxy; this remains for backward-compatible server fallbacks.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side Next.js requests. The Compose default uses http://backend:8000.
RECIPE_API_URL=http://localhost:8000
