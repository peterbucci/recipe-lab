# Install this file as /etc/recipe-lab/sandbox.env with mode 0640 and replace every placeholder.
# It contains the private proxy-proof secret. Never commit or print the populated file.
RECIPE_LAB_BACKEND_IMAGE_ID=sha256:<64-hex-character-local-image-id>
RECIPE_LAB_FRONTEND_IMAGE_ID=sha256:<64-hex-character-local-image-id>
RECIPE_LAB_ORIGIN=https://recipes.peterbucci.com
RECIPE_LAB_CONTACT_URL=mailto:<portfolio-contact-address>
# Use the exact private host-gateway IPv4 address resolved from the Coolify proxy.
RECIPE_LAB_LISTEN_HOST=<private-host-gateway-ipv4>
# With proof enabled, prefer the audited canonical proxy-network CIDR; exact stable IPs also work.
RECIPE_LAB_TRUSTED_PROXY_CIDRS=<coolify-proxy-ip-or-narrow-network-cidr>
TRUSTED_PROXY_PROOF_SECRET=<64-lowercase-hex-characters-generated-on-host>
